  "formulas": {
    "stat": {
      "inputs": [
        "base",
        "growth",
        "level",
        "initial_level",
        "gear"
      ],
      "constants": {},
      "expression": "base + growth * (level - initial_level) + gear"
    },
    "max_hp": {
      "inputs": [
        "base_hp",
        "growth",
        "level",
        "initial_level"
      ],
      "constants": {},
      "expression": "base_hp + growth * (level - initial_level)"
    },
    "physical": {
      "inputs": [
        "attack",
        "defense",
        "variance",
        "outgoing",
        "incoming",
        "minimum",
        "attack_scale",
        "defense_scale"
      ],
      "constants": {
        "minimum": 1,
        "attack_scale": 1.5,
        "defense_scale": 0.7
      },
      "expression": "max(minimum, floor((attack * attack_scale - defense * defense_scale) * variance * outgoing * incoming))"
    },
    "magic": {
      "inputs": [
        "power",
        "magic",
        "resistance",
        "variance",
        "minimum",
        "magic_scale",
        "resistance_scale"
      ],
      "constants": {
        "minimum": 1,
        "magic_scale": 1.2,
        "resistance_scale": 0.5
      },
      "expression": "max(minimum, floor((power + magic * magic_scale - resistance * resistance_scale) * variance))"
    },
    "healing": {
      "inputs": [
        "power",
        "spirit",
        "spirit_scale"
      ],
      "constants": {
        "spirit_scale": 1.1
      },
      "expression": "floor(power + spirit * spirit_scale)"
    },
    "revive": {
      "inputs": [
        "max_hp",
        "fraction",
        "minimum"
      ],
      "constants": {
        "minimum": 1
      },
      "expression": "max(minimum, floor(max_hp * fraction))"
    },
    "escape": {
      "inputs": [
        "party_agility",
        "enemy_agility",
        "base_chance",
        "agility_factor",
        "min_chance",
        "max_chance"
      ],
      "constants": {
        "base_chance": 0.45,
        "agility_factor": 0.025,
        "min_chance": 0.15,
        "max_chance": 0.95
      },
      "expression": "clamp(base_chance + (party_agility - enemy_agility) * agility_factor, min_chance, max_chance)"
    },
    "experience": {
      "inputs": [
        "total",
        "survivors"
      ],
      "constants": {},
      "expression": "floor(total / survivors)"
    }
  },
